      <memberdef kind="function" id="class_u_tryll_languages_1a33818d96050ecef03ba62393394cad1b" prot="public" static="yes" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>bool</type>
        <definition>static bool UTryllLanguages::ModelSupportsLanguage</definition>
        <argsstring>(const FTryllModelInfo &amp;Model, const FString &amp;Locale)</argsstring>
        <name>ModelSupportsLanguage</name>
        <qualifiedname>UTryllLanguages::ModelSupportsLanguage</qualifiedname>
        <param>
          <type>const <ref refid="struct_f_tryll_model_info" kindref="compound">FTryllModelInfo</ref> &amp;</type>
          <declname>Model</declname>
        </param>
        <param>
          <type>const FString &amp;</type>
          <declname>Locale</declname>
        </param>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Whether Model covers Locale (a tag like &quot;de-DE&quot; or a bare code like &quot;de&quot;).</para>
<para>Returns true for a model that declares nothing: without a catalog claim we have no evidence either way, and the server applies the same rule - it withholds the language hint rather than refusing to load the model. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="C:/_tryll/_monorepo3/tryll/clients/unreal/Source/TryllClient/Public/TryllLanguages.h" line="71" column="13"/>
