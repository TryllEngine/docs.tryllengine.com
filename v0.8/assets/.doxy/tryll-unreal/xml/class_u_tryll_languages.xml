      <memberdef kind="function" id="class_u_tryll_languages_1a8fc0dc5082926f7a35d7eeae99dda0e5" prot="public" static="yes" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>FString</type>
        <definition>static FString UTryllLanguages::LanguageOf</definition>
        <argsstring>(const FString &amp;Locale)</argsstring>
        <name>LanguageOf</name>
        <qualifiedname>UTryllLanguages::LanguageOf</qualifiedname>
        <param>
          <type>const FString &amp;</type>
          <declname>Locale</declname>
        </param>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Primary language subtag of a locale, lowercase: &quot;pt-BR&quot; -&gt; &quot;pt&quot;. This is the granularity models work at - none of the shipped voice or speech models distinguish pt-BR from pt-PT. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="C:/_tryll/_monorepo3/tryll/clients/unreal/Source/TryllClient/Public/TryllLanguages.h" line="79" column="16"/>
