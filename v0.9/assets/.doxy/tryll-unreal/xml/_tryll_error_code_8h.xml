    <sectiondef kind="enum">
      <memberdef kind="enum" id="_tryll_error_code_8h_1a360da770ac4dbf26ed954170d352944d" prot="public" static="no" strong="yes">
        <type>int32</type>
        <name>ETryllErrorCode</name>
        <enumvalue id="_tryll_error_code_8h_1a360da770ac4dbf26ed954170d352944daa60852f204ed8028c1c58808b746d115" prot="public">
          <name>Ok</name>
          <initializer>= 0</initializer>
          <briefdescription>
          </briefdescription>
          <detaileddescription>
<para>No error. Success sentinel. </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="_tryll_error_code_8h_1a360da770ac4dbf26ed954170d352944daaf98071f760be899f4fcf1d53a29ba17" prot="public">
          <name>ConnectionFailed</name>
          <initializer>= 1001</initializer>
          <briefdescription>
          </briefdescription>
          <detaileddescription>
<para>TCP connect failed outright. </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="_tryll_error_code_8h_1a360da770ac4dbf26ed954170d352944da42a909b5554948186a4b10a0dea5b7b9" prot="public">
          <name>ConnectionDropped</name>
          <initializer>= 1002</initializer>
          <briefdescription>
          </briefdescription>
          <detaileddescription>
<para>Established connection was dropped mid-session (peer close or socket error). </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="_tryll_error_code_8h_1a360da770ac4dbf26ed954170d352944dac85a251cc457840f1e032f1b733e9398" prot="public">
          <name>Timeout</name>
          <initializer>= 1003</initializer>
          <briefdescription>
          </briefdescription>
          <detaileddescription>
<para>Client-side timeout waiting for a response frame; the socket itself may still be healthy. </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="_tryll_error_code_8h_1a360da770ac4dbf26ed954170d352944da0e29610e7c8be800f4fbb53ea785afb0" prot="public">
          <name>ServerShuttingDown</name>
          <initializer>= 2001</initializer>
          <briefdescription>
          </briefdescription>
          <detaileddescription>
<para>Server is shutting down and no longer accepts requests on this session. </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="_tryll_error_code_8h_1a360da770ac4dbf26ed954170d352944da6106a2fb8efa35b8c3053113c9e20595" prot="public">
          <name>SessionNotReady</name>
          <initializer>= 2002</initializer>
          <briefdescription>
          </briefdescription>
          <detaileddescription>
<para>A non-CreateSession request arrived before CreateSession created the session. </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="_tryll_error_code_8h_1a360da770ac4dbf26ed954170d352944da06a7bffd7a6eecf957b889c311a10282" prot="public">
          <name>SessionAlreadyExists</name>
          <initializer>= 2003</initializer>
          <briefdescription>
          </briefdescription>
          <detaileddescription>
<para>A second CreateSessionRequest arrived on a connection that already has a session. </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="_tryll_error_code_8h_1a360da770ac4dbf26ed954170d352944dac4bc7401e87b528b2db08b351e5f9367" prot="public">
          <name>InvalidLocale</name>
          <initializer>= 2004</initializer>
          <briefdescription>
          </briefdescription>
          <detaileddescription>
<para>CreateSessionRequest.locale is not a well-formed BCP-47 tag. </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="_tryll_error_code_8h_1a360da770ac4dbf26ed954170d352944da82c7f01528ff9ae6d74204916dbdc912" prot="public">
          <name>InvalidEngineSet</name>
          <initializer>= 2005</initializer>
          <briefdescription>
          </briefdescription>
          <detaileddescription>
<para>An entry in CreateSessionRequest.model_config carries an ordinal that is not a valid ModelRole, InferenceEngine or MemoryPlacement value.</para>
<para>This is the <emphasis>only</emphasis> remaining cause. The engine set is advisory (spec §7.1): it may be empty, incomplete, or name an engine the session never uses, and none of that is an error. What cannot be tolerated is an out-of-range ordinal, because the wire value is cast to an enum and a bad cast is undefined behaviour rather than a wrong answer. </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="_tryll_error_code_8h_1a360da770ac4dbf26ed954170d352944da22ab3ef06934a2bdad77f3b96ac9c2b7" prot="public">
          <name>InvalidAgentId</name>
          <initializer>= 3001</initializer>
          <briefdescription>
          </briefdescription>
          <detaileddescription>
<para>Request referenced an agent_id the server does not know (wrong id or already destroyed). </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="_tryll_error_code_8h_1a360da770ac4dbf26ed954170d352944da3594330042030625e094e1ee40dec1b1" prot="public">
          <name>AgentAlreadyDestroyed</name>
          <initializer>= 3002</initializer>
          <briefdescription>
          </briefdescription>
          <detaileddescription>
<para>Agent was previously destroyed; the id is no longer valid. </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="_tryll_error_code_8h_1a360da770ac4dbf26ed954170d352944da7ac0537b2e34f2ac65c231e4f3187521" prot="public">
          <name>GraphCompilationFailed</name>
          <initializer>= 3003</initializer>
          <briefdescription>
          </briefdescription>
          <detaileddescription>
<para>Server failed to compile the workflow graph into an executable plan. </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="_tryll_error_code_8h_1a360da770ac4dbf26ed954170d352944da3945ed447cdfbefd74ad77ab2b577871" prot="public">
          <name>AgentBusy</name>
          <initializer>= 3004</initializer>
          <briefdescription>
          </briefdescription>
          <detaileddescription>
<para>Agent is still processing the previous turn and cannot accept a new message yet. This is the re-entrancy rejection. </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="_tryll_error_code_8h_1a360da770ac4dbf26ed954170d352944da661b4154b14a3766edd085c867d6fafc" prot="public">
          <name>UnknownNode</name>
          <initializer>= 3005</initializer>
          <briefdescription>
          </briefdescription>
          <detaileddescription>
<para>node_name not found in the agent&apos;s graph. </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="_tryll_error_code_8h_1a360da770ac4dbf26ed954170d352944da6f66d136cac83d4f8c789ebfa700341e" prot="public">
