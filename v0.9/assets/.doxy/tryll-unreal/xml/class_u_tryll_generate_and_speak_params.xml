      <memberdef kind="variable" id="class_u_tryll_generate_and_speak_params_1ad14b273082daf73bf32a5024d3ce8c60" prot="public" static="no" mutable="no">
        <type>int32</type>
        <definition>int32 UTryllGenerateAndSpeakParams::MinSentenceChars</definition>
        <argsstring></argsstring>
        <name>MinSentenceChars</name>
        <qualifiedname>UTryllGenerateAndSpeakParams::MinSentenceChars</qualifiedname>
        <initializer>= 12</initializer>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Minimum width of the text since the last cut before a sentence end closes a chunk; a CJK or other 3–4-byte character counts as 2. The default 12 is two or three English words. Lower values reduce first-utterance latency at the cost of more, smaller TTS calls. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="C:/_tryll/_monorepo3/tryll/clients/unreal/Source/TryllClient/Public/Generated/Nodes/TryllGenerateAndSpeakParams.h" line="122" column="11" bodyfile="C:/_tryll/_monorepo3/tryll/clients/unreal/Source/TryllClient/Public/Generated/Nodes/TryllGenerateAndSpeakParams.h" bodystart="122" bodyend="-1"/>
